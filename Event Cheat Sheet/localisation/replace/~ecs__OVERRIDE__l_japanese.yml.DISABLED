 ##########################
 ### astral_rifts_0.yml ###
 ##########################
 # Ruined Planet
 astral_rift.3.a: "Visit the §Y[GetStarlightVanguardName]§!. §Y(+10% Kinetic Damage)§!"
 astral_rift.3.b: "Visit the §YBlack Curtain§!. §Y(+5% £pops£ Growth and Habitability)§!" 
 
 astral_rift.10.a: "Offer alloys. §Y(+10% £ship_stats_armor£ HP and Hardening)§!"
 astral_rift.10.b: "Offer astral thread. §Y(+10% £ship_stats_shield£ HP and Hardening)§!"
 
 astral_rift.15.a: "Offer food. §Y(+0.5 £food£ from Farmers)§!"
 astral_rift.15.a.lithoid: "Offer minerals. §Y(+0.5 £minerals£ from Miners)§!"
 astral_rift.15.a.synthetic: "Offer energy. §Y(+0.5 £energy£ from Technicians)§!"
 astral_rift.15.b: "Offer astral thread. §Y(+25% £astral_rift£ Speed and -50% Fail Chance)§!"
 
 astral_rift.20.a: "Offer astral thread. §Y(+5% Sublight Speed)§!"
 astral_rift.20.b: "Offer energy. §Y(+5% Ship Build Speed)§!"

 # The Corridors
 astral_rift.115.a: "Hack it. §Y(Risks £scientist£ Lost 5 Years, +1 Max £district£)§!"
 astral_rift.115.b: "Strip it for parts. §Y(Safely Ends Rift)§!" 

 # Dimensional Conflict
 astral_rift.200.a: "Study its composition. §Y(£alloys£, Armor Tech, £specimen£)§!" 
 astral_rift.200.b: "Let's get in there. §Y(Biology Tech)§!"

 astral_rift.215.a: "Try to activate the dodecahedron. §Y(Relic)§!"
 astral_rift.215.b: "Strip it for parts. §Y(£sr_dark_matter£)§!"

 # The Lattice
 astral_rift.325.a: "Retrieve the globes. §G(9 Fractal Seeds)§!"
 astral_rift.325.b: "We are done here. §R(Only 3 Fractal Seeds)§!"
 
 # Subnautical
 astral_rift.505.a: "Activate the engines. §Y(Fastest Route)§!"
 astral_rift.520.b: "Approach the Object. §Y(Fastest Route)§!"

 # The Tower
 astral_rift.600.a: "Attempt to communicate with the creature. §Y(New £scientist£/£society£ £research£)§!"
 astral_rift.600.b: "Observe the creature and report back. §Y(New £scientist£/£society£ £research£)§!"
 astral_rift.600.c: "Kill it. §Y(£unity£)§!" 
 
 astral_rift.605.a: "Invite them aboard. §Y(New £scientist£/£society£ £research£)§!"
 astral_rift.605.b: "Offer something in return. §Y(£unity£)§!"
 astral_rift.605.c: "Leave the site. §R(Ends Rift)§!"
 
 astral_rift.610.a: "Invite them aboard. §Y(New £scientist£/£society£ £research£)§!"
 astral_rift.610.b: "Offer something in return. §Y(£unity£)§!"
 astral_rift.610.c: "Leave the site. §R(Ends Rift)§!"
 astral_rift.610.d: "Kill the creature. §Y(£unity£)§!" 

 # Whiteout
 astral_rift.700.a: "Maximize propulsion. §Y(£astral_threads£)§!"
 astral_rift.700.b: "Release a drone. §Y(£physics£)§!"

 astral_rift.715.a: "Take a sample. §Y(£rare_crystals£)§!"
 astral_rift.715.b: "Trace a map. §Y(£society£)§!" 
 
 # The Advisor
 astral_rift.805.a: "Ask for FURTHER assistance. §R(Lose £scientist£ for 5 Years)§!"
 
 astral_rift.810.a: "Placate the machine. §R(Lose £scientist£ for 5 Years)§!"
 
 astral_rift.820.a: "Attempt to recover its core. §Y(£specimen£, £alloys£, £physics£ Tech)§!"
 astral_rift.820.b: "Destroy the machine completely. §Y(£engineering£)§!"
 
 # The Vortex
 astral_rift.900.b: "Expose sample to flame. §Y(Risks £scientist£, +10% £energy£)§!"

 ##########################
 ### astral_rifts_1.yml ###
 ##########################
 # The Crystal Rift
 astral_rift.1000.a: "Utilize A.I. to check for hidden patterns."
 astral_rift.1000.b: "E.M.P. the anchor cord. §R(Waste of £energy£)§!"

 astral_rift.1010.b: "Get out! We've only stunned it. §R(Ends Rift)§!"

 astral_rift.1020.a: "We've opened a doorway... §G(Opens Wormhole)§!"
 astral_rift.1020.b: "Seal it! Quickly! §R(Ends Rift)§!"

 # Hatching Ground
 astral_rift.1105.a: "Get closer. §Y(£engineering£, £unity£)§!"
 astral_rift.1105.b: "Maintain a safe distance. §Y(Propulsion £research£ Speed)§!" 
 
 # The Microverse
 astral_rift.1210.a: "Synchronize with the [Fleet.GetName]. §R(Ends Rift)§!"
 
 astral_rift.1220.b: "Observe from the edge of the universe. §R(Ends Rift)§!"

 # The Fluid
 astral_rift.1315.a: "Pull anchor. Return immediately. §Y(+10% Biology £research£)§!"
 astral_rift.1315.b: "Pump exotic gasses. Neutralize the beast. §Y(Risks £scientist£, Relic)§!" 

 # The Garden
 astral_rift.1400.b: "Extract the fruit. §R(Risks £scientist£)§!"
 
 astral_rift.1405.a: "Burn the entangling vines. §R(Risks £scientist£)§!"
 astral_rift.1405.b: "Pull anchor. Escape. §Y(Safely End Rift)§!"
 
 astral_rift.1410.b: "Study this place. §G(£specimen£, Safest Route)§!"
 
 astral_rift.1425.a: "Escape. §Y(Safely End Rift)§!"
 astral_rift.1425.b: "Do nothing. §R(Kills £scientist£)§!"
 astral_rift.1425.c: "Burn the Creature. §Y(Risks £scientist£, Relic)§!" 
 
 astral_rift.1430.a: "Escape. §Y(Safely End Rift)§!"
 astral_rift.1430.b: "Burn the Creature. §Y(Risks £scientist£, Relic)§!"

 astral_rift.1435.a: "Escape. §Y(Safely End Rift)§!"
 astral_rift.1435.b: "Burn the Creature. §Y(Risks £scientist£, Relic)§!"

 astral_rift.1440.a: "Burn the Creature. §G(Relic)§!"
 astral_rift.1440.b: "Continue Studies. §R(Risks £scientist£, Relic)§!" 
 
 
 # Desert Ruins
 astral_rift.1520.b: "Press the §Ggreen§! button. §R(Kills £scientist£)§!"
 astral_rift.1530.a: "Press the triangle button. §R(Kills £scientist£)§!"
 astral_rift.1550.a: "Press button with four dots. §R(Kills £scientist£)§!"
 
 # Strange Station
 astral_rift.1615.a: "Welcome friendship. §Y(£specimen£, £society£, Trading Contact)§!"
 astral_rift.1615.b: "Spurn their offer. §Y(£unity£)§!"
 astral_rift.1615.c: "Accept this opportunity. §Y(£specimen£, £society£, Trading Contact)§!"
 astral_rift.1615.d: "This is of no interest to us. §Y(£unity£)§!"
 
 # Lone Object
 astral_rift.1705.b: "Blast it open. §Y(Risk Spawning Fleet,£minerals£,£alloys£,£rare_crystals£,£unity£)§!" 
 
 astral_rift.1710.b: "Blast it open. §Y(Risk Spawning Fleet,£minerals£,£alloys£,£rare_crystals£,£unity£)§!"
 
 astral_rift.1715.a: "Take samples and return. §Y(Safely Ends Rift)§!"
 astral_rift.1715.b: "Engage destructive exploration. §Y(Risk Spawning Fleet,£minerals£,£alloys£,£rare_crystals£,£unity£)§!"
 
 # Rockworms
 astral_rift.1815.a: "Set explosive charges. §Y(Risks £scientist£, £minerals£ Buff Decision)§!"
 astral_rift.1815.b: "Pull emergency anchor. §Y(Safely Ends Rift)§!"
 
 astral_rift.1820.b: "We've pushed our luck far enough. Return at once. §Y(Safely Ends Rift)§!"
 astral_rift.1820.b.evopred: "Gather the samples and return. §Y(Safely Ends Rift)§!"
 
 # Volcanic Plane
 astral_rift.1905.a: "Pull the emergency anchor. §Y(Safely Ends Rift)§!"
 astral_rift.1905.b: "Hide in the lava." 
 
 astral_rift.1910.a: "Attempt to escape."
 astral_rift.1910.b: "This is dangerous. Pull the emergency anchor. §Y(Safely Ends Rift)§!"
 
 astral_rift.1915.a: "Decipher the runes."
 astral_rift.1915.b: "Destroy the obelisk. §Y(Risks £scientist£,£minerals£,£alloys£,£unity£,£specimen£)§!"
 
 astral_rift.1925.a: "Enough. Pull the emergency anchor. §Y(Safely Ends Rift)§!"
 astral_rift.1925.b: "Destroy this infernal device. §Y(Risks £scientist£,£minerals£,£alloys£,£unity£,£specimen£)§!"
 
 ##########################
 ### astral_rifts_2.yml ###
 ##########################
 # Abandoned Complex
 astral_rift.2000.a: "Search for the caretakers. §R(Waste of Time)§!" 
 astral_rift.2000.b: "Open an egg."

 astral_rift.2010.a: "Inject the liquid into the egg. §Y(§RRisks £military_power_boss£§!, £society£, £physics£/£army_power£ Unlock)§!"
 astral_rift.2010.b: "Euthanize the remaining creatures. §Y(£physics£)§!"
 
 astral_rift.2015.a: "Open an egg."
 astral_rift.2015.b: "Return with the remains. §R(Ends Rift)§!"
 
 astral_rift.2020.a: "Do not intervene. §R(Kills £scientist£, £physics£)§!"
 astral_rift.2020.b: "Inject astral thread. §Y(£army_power£ Unlock)§!"

 # The Mechanism
 astral_rift.2105.a: "Interfering would be irresponsible. §Y(£engineering£)§!"
 astral_rift.2105.b: "Jam the gears. §Y(Relic/£engineering£, Risk £scientist£ Aging 20 Years)§!" 

 # Dimensional Dump
 astral_rift.2205.a: "Dispatch the individual. §Y(Risks £scientist£, £alloys£, £engineering£, £minerals£)§!"
 astral_rift.2205.b: "Attempt to negotiate. §Y(£society£, Level 6 £commander£)§!"
 
 # Genesis
 astral_rift.2300.a: "Arm them with might. §Y(100 £pops£ and £specimen£)§!"
 astral_rift.2300.b: "Plant the seeds of knowledge. §Y(100 £pops£ and £specimen£)§!"
 astral_rift.2300.c: "We play no games. Activate an E.M.P. §Y(£alloys£)§!"

 # Entangled Dark Matter
 astral_rift.2405.a: "Remove the device. §R(£sr_dark_matter£, Ends Rift)§!"

 astral_rift.2415.a: "Offer this scientist as a vessel. §Y(Risks £scientist£ for Rift Traits)§!"
 astral_rift.2415.b: "Deny this proposal. §Y(£sr_dark_matter£/£engineering£, £physics£)§!"
 astral_rift.2415.c: "Assimilate the entity. §Y(+5% £research£ Speed)§!"
 astral_rift.2415.d: "Deny assimilation. §Y(£sr_dark_matter£/£engineering£, £physics£)§!"

 astral_rift.2420.a: "Euthanize the ethereal creature. §Y(£sr_dark_matter£)§!"
 astral_rift.2420.b: "Preserve the captive for study. §Y(£engineering£, £physics£)§!"
 astral_rift.2420.c: "Kill it. §Y(£engineering£, £physics£)§!"

 # Bleached Planet
 astral_rift.2505.b: "Prepare for contact. §Y(£society£)§!"
 
 astral_rift.2510.a: "Fly towards the distant horizon. §R(£scientist£ Blinded)§!"

 astral_rift.2515.a: "Examine a rock creature. §Y(Bio Tech)§!"
 
 astral_rift.2530.a: "Observe the dark star. §R(£scientist£ Blinded)§!"
 astral_rift.2530.b: "Retreat. §Y(£physics£ Deposit)§!"
 
 # Chemical Wasteland
 astral_rift.2600.a: "Investigate the robots. §Y(Amenities Edict/£energy£/£alloys£)§!"
 astral_rift.2600.b: "Explore the cave. §Y(£specimen£/Hacking Tech/£scientist£ Rift Skill Trait)§!"
 
 astral_rift.2605.a: "Allow the drones to approach. §R(Prevents £alloys£)§!"
 
 astral_rift.2620.a: "Trace the distress signal. §Y(Amenities Edict/£energy£)§!"
 astral_rift.2620.b: "Flee before potential reinforcements arrive. §Y(£alloys£)§!"
 
 astral_rift.2645.a: "Document and study the sanitary infrastructure. §Y(Amenities Edict)§!"
 astral_rift.2645.b: "Shut down the Facility. §Y(£energy£)§!"
 
 astral_rift.2640.a: "Repurpose the drone's technology. §Y(£specimen£)§!"
 astral_rift.2640.b: "Engineer a virus to disable the sanitation network. §Y(Hacking Tech)§!"
 astral_rift.2640.c: "Keep this drone as a personal research assistant. §Y(£scientist£ Rift Skill Trait)§!"

 # Windswept Planet
 astral_rift.2725.a: "Find a way to remove the fungus. §Y(£energy£ Decision, Ends Rift)§!"
 
 astral_rift.2730.a: "Protect the ecosystem against the wind. §Y(+25% £exotic_gases£,£specimen£, Ends Rift)§!"
 
 astral_rift.2745.a: "Fortify the wind. §Y(£energy£ Decision)§!"
 astral_rift.2745.b: "Nourish the fungus. §Y(+25% £exotic_gases£,£specimen£)§!"
 astral_rift.2745.c: "Negotiate a compromise. §Y(£society£ Deposit,£exotic_gases£,£energy£,£unity£,£envoy£)§!"
 astral_rift.2745.d: "Eradicate both species. §Y(£food£,£unity£)§!"
 
 # Tiny Planet
 astral_rift.2810.a: "Establish contact. §Y(£unity£, £energy£ Decision/£stability£ Decision/£society£  Deposit)§!"
 astral_rift.2810.b: "Observe passively. §Y(£society£ Deposit, Ends Rift)§!"
 astral_rift.2810.c: "Demand ransom. §Y(£unity£, £energy£ Decision/£stability£ Decision/£society£  Deposit)§!"
 astral_rift.2810.d: "Inform them that their doom has come. §Y(£unity£, £society£ Deposit)§!"
 astral_rift.2810.e: "Watch the destruction unfold. §Y(£society£ Deposit, £unity£, Ends Rift)§!"
 
 astral_rift.2815.a: "Attempt to fix the moon's orbit. §Y(£unity£, £energy£ Decision)§!"
 astral_rift.2815.b: "Destroy the moon. §Y(£stability£ Decision/£society£  Deposit)§!"
 astral_rift.2815.c: "Cut communications. Observe passively. §Y(£society£  Deposit)§!"
 astral_rift.2815.d: "Cut communications. Watch the destruction unfold. §Y(£society£ Deposit, £unity£)§!"

 astral_rift.2825.a: "Put them out of their misery. §Y(£stability£ Decision)§!"
 astral_rift.2825.b: "Deploy remote research devices. §Y(£society£ Deposit)§!" 
 
 # Entertainment Nexus
 astral_rift.2925.a: "Meet with the vulpine acrobats. §Y(Genetic Tech/Wormhole Tech)§!"
 astral_rift.2925.b: "Meet with the cyborg maw. §Y(£mod_job_healthcare_add£ Output/Robotic Tech)§!"
 astral_rift.2925.c: "Meet with the contortionist. §Y(£rare_crystals£ Edict/£physics£)§!" 
 
 astral_rift.2930.a: "Secure a tissue sample. §Y(£specimen£, Genetic Tech)§!"
 astral_rift.2930.b: "Tip them some energy credits. §Y(Wormhole Stabilization)§!"
 
 astral_rift.2935.a: "Secure a tissue sample. §Y(£specimen£, £mod_job_healthcare_add£ Output)§!"
 astral_rift.2935.b: "Offer a snack. §Y(Robotic Tech)§!"
 
 astral_rift.2940.a: "Secure a tissue sample. §Y(£specimen£, £rare_crystals£ Edict)§!"
 astral_rift.2940.b: "Tip them some energy credits. §Y(£physics£)§!"
 
