 ### astral_rifts_3.yml ###
 ##########################
 # Siege on Paradise
 astral_rift.3000.a: "Contact the planet's inhabitants. §Y(£commander£/£outliner_fleet_cloaked£ Edict/300 £pops£/+5% £ship_stats_shield£)§!"
 astral_rift.3000.b: "Contact the orbiting fleet. §Y(Possibly +10% Fire Rate/£society£, £army_power£ Unlock)§!" 

 astral_rift.3010.a: "We will help however we can. §Y(£commander£/£outliner_fleet_cloaked£ Edict/300 £pops£/+5% £ship_stats_shield£)§!"
 astral_rift.3010.b: "It is not our place to interfere. §R(£society£, £engineering£)§!"

 astral_rift.3020.a: "Genetically modify the Baol. §Y(£commander£)§!"
 astral_rift.3020.b: "Deploy experimental planetary cloaking. §Y(£outliner_fleet_cloaked£ Edict)§!"
 astral_rift.3020.c: "Preserve the seedlings. §Y(300 £pops£)§!"
 astral_rift.3020.d: "Generate an astral shield. §Y(+5% £ship_stats_shield£ HP and Hardening)§!"
 
 # ik its +10% fire rate, not damage, but there isn't room for "Fire Rate"
